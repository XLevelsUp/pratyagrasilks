# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are deliberately UNANCHORED (no leading slash) so they match inside
# apps/* and packages/* as well as the repo root.

# dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# testing
coverage/

# next.js
.next/
out/

# production
build/

# turborepo
.turbo/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings (machine-specific)
.claude/settings.local.json
.claude/

# Agent skill files — installed per-developer via: npx skills add supabase/agent-skills
.agents/

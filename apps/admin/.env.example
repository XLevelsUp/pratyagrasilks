# Admin portal — admin.pratyagrasilks.com
# Copy to .env.local and fill in. See the note in the storefront's .env.example
# about turbo's strict env mode and NEXT_PUBLIC_* vars.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Link back to the storefront from the admin sidebar
NEXT_PUBLIC_STOREFRONT_URL=https://pratyagrasilks.com

# MUST point at the ADMIN host, not the storefront: lib/trigger-meta-sync.ts
# falls back to this when VERCEL_URL is absent, and pointing it at the
# storefront POSTs to a host that no longer serves /api/cron/*, giving a 404
# that the caller swallows — on-demand catalog sync then silently stops.
NEXT_PUBLIC_SITE_URL=https://admin.pratyagrasilks.com

# Meta catalog sync (cron). CRON_SECRET is required — the route fails closed
# without it, so the daily sync never runs.
CRON_SECRET=
META_CATALOG_ID=
META_CATALOG_TOKEN=
META_CATALOG_DRY_RUN=

# Admin portal — admin.pratyagrasilks.com
# Copy to .env.local. Every variable here is read somewhere in apps/admin;
# NODE_ENV and VERCEL_URL are supplied by the runtime and are not listed.
# See the note in the storefront's .env.example about turbo's strict env mode.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Meta catalog sync ───────────────────────────────────────────────────────
# CRON_SECRET is required: the cron route fails closed without it, so the
# daily catalog sync silently never runs.
CRON_SECRET=
META_CATALOG_ID=
META_CATALOG_TOKEN=
# Set to 'true' to log intended Meta writes instead of performing them.
META_CATALOG_DRY_RUN=

# ── This app's own public origin ────────────────────────────────────────────
# MUST be the ADMIN host, not the storefront. lib/trigger-meta-sync.ts falls
# back to this when VERCEL_URL is absent and POSTs to /api/cron/*, which only
# this app serves. Pointing it at the storefront yields a 404 that the caller
# swallows, and on-demand catalog sync silently stops working.
NEXT_PUBLIC_SITE_URL=https://admin.pratyagrasilks.com

# ── Optional ────────────────────────────────────────────────────────────────
# "Back to Store" link in the admin sidebar. Defaults to
# https://pratyagrasilks.com; set it only to point at a preview storefront.
# NEXT_PUBLIC_STOREFRONT_URL=

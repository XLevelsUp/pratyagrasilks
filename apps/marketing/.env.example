# Storefront — pratyagrasilks.com
# Copy to .env.local and fill in. Every NEXT_PUBLIC_* var must also be listed
# in turbo.json's build task `env` array: turbo runs in strict env mode, and an
# unlisted var is undefined at build time and gets inlined as undefined into
# the client bundle with no error.

# Supabase (service role is NOT admin-only — checkout, orders and the contact
# form all use it from this app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URLs
NEXT_PUBLIC_SITE_URL=https://pratyagrasilks.com
NEXT_PUBLIC_ADMIN_URL=https://admin.pratyagrasilks.com

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Instagram reels
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_COLLECTION_ACCESS_TOKEN=

# Analytics
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# WhatsApp order notifications
NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_SALES_RECIPIENT_NUMBER=
WHATSAPP_SALE_TEMPLATE_NAME=
WHATSAPP_TEST_NUMBER=

# Storefront — pratyagrasilks.com
# Copy to .env.local. Every variable here is read somewhere in apps/marketing;
# NODE_ENV and VERCEL_URL are supplied by the runtime and are not listed.
#
# Adding a NEXT_PUBLIC_* var? Add it to turbo.json's build `env` array too.
# Turbo runs in strict env mode, so an unlisted var is undefined at build time
# and gets inlined as undefined into the client bundle, with no error.

# ── Supabase ────────────────────────────────────────────────────────────────
# The service-role key is NOT admin-only: checkout, order lookup and the
# contact form all use it from this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments (Razorpay) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Signing secret of the Razorpay Dashboard webhook pointing at
# /api/webhooks/razorpay (events: payment_link.paid / .expired / .cancelled).
RAZORPAY_WEBHOOK_SECRET=

# ── AI sales agent API (/api/agent/*) ───────────────────────────────────────
# Bearer key(s) for the agent's server. Comma-separate two keys to rotate
# without downtime. Each key must be at least 32 characters; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_KEY=
# Payment link lifetime in minutes (default 1440 = 24h, minimum 16).
AGENT_LINK_TTL_MIN=

# ── Transactional email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Instagram reels ─────────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_COLLECTION_ACCESS_TOKEN=

# ── WhatsApp order notifications ────────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_SALE_TEMPLATE_NAME=
WHATSAPP_SALES_RECIPIENT_NUMBER=
WHATSAPP_TEST_NUMBER=

# ── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Optional ────────────────────────────────────────────────────────────────
# Target of the /admin/* 301s. Defaults to https://admin.pratyagrasilks.com;
# set it only to point at a preview or local admin deployment.
# NEXT_PUBLIC_ADMIN_URL=

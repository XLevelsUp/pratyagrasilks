# Copy to .env.backup.local in this folder (gitignored) and fill it in.

# ── Database ────────────────────────────────────────────────────────────────
# Dashboard → Connect → "Session pooler" (port 5432). Change the user from
# postgres.<ref> to backup_reader.<ref> (see README.md) and put its password in:
#   postgresql://backup_reader.<ref>:<password>@<pooler-host>:5432/postgres
# URL-encode special characters in the password:
#   @ → %40   # → %23   / → %2F   % → %25   & → %26   : → %3A
SUPABASE_DB_URL=

# ── Storage ─────────────────────────────────────────────────────────────────
# The same values the apps use: Vercel env vars, or
# Dashboard → Project Settings → API Keys (service_role / secret key).
# SUPABASE_URL looks like https://<ref>.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Project settings (optional) ─────────────────────────────────────────────
# Exports Auth providers, redirect URLs, email templates, SMTP, Storage and
# API settings. Create one at https://supabase.com/dashboard/account/tokens
# This token can manage every project on your account: revoke it after the
# backup, or leave this blank and record those settings by hand.
SUPABASE_ACCESS_TOKEN=

# ── Output (optional) ───────────────────────────────────────────────────────
# Relative paths are from the repo root. The default keeps backups outside
# the repo, so customer data can never be committed.
# BACKUP_ROOT=../pratyagrasilks-backups
